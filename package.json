{
  "name": "homepage",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ncu": "pnpm dlx npm-check-updates --target patch",
    "ncuu": "pnpm dlx npm-check-updates --target patch -u",
    "generate:db": "nuxt db generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "build": "nuxt build",
    "backup": "wrangler d1 export DB --remote --output ./db.sql",
    "deploy": "NITRO_PRESET=cloudflare_module nuxt build && wrangler deploy --keep-vars && wrangler --config .output/server/wrangler.json d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@nuxt/ui": "4.10.0",
    "@nuxthub/core": "0.10.8",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.8",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@iconify-json/lucide": "1.2.121",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-plugin-format": "2.0.1",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.9",
    "wrangler": "4.119.0"
  }
}
